+import pl from "./locales/pl-PL"
+
+export const TRANSLATIONS = {
+  "en-US": en,
+  "fr-FR": fr,
+  "it-IT": it,
+  "ja-JP": ja,
+  "de-DE": de,
+  "nl-NL": nl,
+  "nl-BE": nl,
+  "ro-RO": ro,
+  "ro-MD": ro,
+  "es-ES": es,
+  "ar-SA": ar,
+  "ar-AE": ar,
+  "ar-QA": ar,
+  "ar-BH": ar,
+  "ar-KW": ar,
+  "ar-OM": ar,
+  "ar-YE": ar,
+  "ar-IR": ar,
+  "ar-SY": ar,
+  "ar-IQ": ar,
+  "ar-JO": ar,
+  "ar-PL": ar,
+  "ar-LB": ar,
+  "ar-EG": ar,
+  "ar-SD": ar,
+  "ar-LY": ar,
+  "ar-MA": ar,
+  "ar-TN": ar,
+  "ar-DZ": ar,
+  "ar-MR": ar,
+  "uk-UA": uk,
+  "ru-RU": ru,
+  "ko-KR": ko,
+  "zh-CN": zh,
+  "vi-VN": vi,
+  "pt-BR": pt,
+  "hu-HU": hu,
+  "fa-IR": fa,
+  "pl-PL": pl,
+} as const
+
+export const defaultTranslation = "en-US"
+export const i18n = (locale: ValidLocale): Translation => TRANSLATIONS[locale ?? defaultTranslation]
+export type ValidLocale = keyof typeof TRANSLATIONS
+export type ValidCallout = keyof CalloutTranslation
